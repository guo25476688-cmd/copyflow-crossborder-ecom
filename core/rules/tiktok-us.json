{
  "id": "tiktok-us",
  "version": "2026-09-21",
  "platform": "tiktok",
  "markets": [
    "en-US"
  ],
  "retrieved_at": "2026-09-21",
  "description": "TikTok Shop 美国站商品 Listing（标题、描述）规则，来自官方卖家大学「Product Listing Policy」（页面日期 2026-09-01）与「Product Listing: What You Need to Know」（2026-08-10），两篇均注明适用于美国站。严重程度跟随官方措辞：写“必须/禁止”的为错误，写“建议/避免/should”的为警告；依据等级同 Amazon 规则集。只覆盖文字，不涉及图片与视频。",
  "rules": [
    {
      "id": "tt.title.max-length",
      "check": "max_length",
      "target": "title",
      "max": 200,
      "severity": "warning",
      "description": "标题建议不超过 200 字符（官方在标题写作建议里写“should be between 25-200 characters”，措辞为建议，故为警告）",
      "fix_hint": "把标题缩短到 200 字符以内",
      "source": {
        "url": "https://seller-us.tiktok.com/university/essay?knowledge_id=7073362639816491&default_language=en",
        "section": "Product Title > Tips for Writing Product Titles",
        "retrieved_at": "2026-09-21"
      }
    },
    {
      "id": "tt.title.min-length",
      "check": "min_length",
      "target": "title",
      "unit": "chars",
      "min": 25,
      "severity": "warning",
      "description": "标题建议不少于 25 字符（同上，措辞为建议）",
      "fix_hint": "补充产品类型、关键特征等识别信息，使标题不少于 25 字符",
      "source": {
        "url": "https://seller-us.tiktok.com/university/essay?knowledge_id=7073362639816491&default_language=en",
        "section": "Product Title > Tips for Writing Product Titles",
        "retrieved_at": "2026-09-21"
      }
    },
    {
      "id": "tt.title.includes-brand",
      "check": "title_includes_brand",
      "severity": "error",
      "description": "标题必须包含品牌（需有授权）。事实表里有品牌时才检查；品牌是否与官网、商标、包装一致无法自动核对",
      "fix_hint": "在标题开头写上品牌名",
      "source": {
        "url": "https://seller-us.tiktok.com/university/essay?knowledge_id=3196690250417921&lang=en",
        "section": "Product Title > It must include: The brand (with authorization)",
        "retrieved_at": "2026-09-21"
      }
    },
    {
