      "patterns": [
        {
          "pattern": "\\ball sizes\\b",
          "basis": "official_example"
        },
        {
          "pattern": "\\b[XS]{1,3}S?\\s*[-–]\\s*\\d?X+L\\b",
          "basis": "official_example"
        },
        {
          "pattern": "\\bavailable in\\b",
          "basis": "derived"
        }
      ],
      "source": {
        "url": "https://seller-us.tiktok.com/university/essay?knowledge_id=7073362639816491&default_language=en",
        "section": "Product Title > Avoid listing all product variations in the title",
        "retrieved_at": "2026-09-21"
      }
